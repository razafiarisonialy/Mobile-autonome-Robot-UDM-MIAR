<?xml version="1.0" ?>
<!--
  Cardboard Factory Warehouse — Gazebo Harmonic (gz-sim 8) / ROS 2 Jazzy
  Shell   : Warehouse model (MovAi/Warehouse)
  Layout  : ~28 m × 19 m usable interior, objects kept inside the shell
  Zones   : Raw Materials (west) | Semi-Finished (centre) | Finished Goods (east)
  Aisles  : wide central traffic lane + 4 m rack-to-rack spacing
  Shelves : ShelfD (RM) | ctrazziwp/shelf (SF, solid bottom → LiDAR-safe) | ShelfF (FG)
  Columns : 10 structural pillars — perimeter + zone boundaries, no centre obstruction
  Robot   : spawned at runtime by ros_gz_sim create (see sim.launch.py)
-->
<sdf version="1.9">
  <world name="warehouse_world">

    <!-- Caméra initiale : vue plongeante sur l'ensemble de l'entrepôt -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -14 12 0 0.8 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ================================================================== -->
    <!--  PHYSICS                                                            -->
    <!-- ================================================================== -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ================================================================== -->
    <!--  SYSTEM PLUGINS (Gazebo Harmonic)                                  -->
    <!-- ================================================================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ================================================================== -->
    <!--  SCENE & LIGHTING                                                  -->
    <!-- ================================================================== -->
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.55 0.58 0.62 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.75 1</diffuse>
      <specular>0.25 0.25 0.20 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light type="point" name="lamp_w">
      <pose>-12 0 5.5 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.03</linear>
        <constant>0.3</constant><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_cw">
      <pose>-5 0 5.5 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.03</linear>
        <constant>0.3</constant><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_ce">
      <pose>5 0 5.5 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.03</linear>
        <constant>0.3</constant><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_e">
      <pose>12 0 5.5 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>20</range><linear>0.03</linear>
        <constant>0.3</constant><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ================================================================== -->
    <!--  BUILDING SHELL — MovAi Warehouse model (scale 1:1)               -->
    <!-- ================================================================== -->
    <include>
      <name>Warehouse_Shell</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/Warehouse</uri>
      <static>true</static>
      <pose>0 0 -0.04 0 0 0</pose>
    </include>

    <!-- Thin collision floor overlay -->
    <model name="floor_collision">
      <static>true</static>
      <pose>0 0 -0.015 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>32 22 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!--  ZONE FLOOR OVERLAYS                                               -->
    <!--  Raw Materials  : blue   (x −12.5 … −5.8)                         -->
    <!--  Semi-Finished  : yellow (x  −5.8 … +5.8)                         -->
    <!--  Finished Goods : green  (x  +5.8 … +12.5)                        -->
    <!-- ================================================================== -->
    <model name="zone_raw_materials">
      <static>true</static>
      <pose>-9.15 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.7 18 0.002</size></box></geometry>
          <material>
            <ambient>0.18 0.28 0.70 0.30</ambient>
            <diffuse>0.18 0.28 0.70 0.30</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_semi_finished">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>11.6 18 0.002</size></box></geometry>
          <material>
            <ambient>0.72 0.62 0.05 0.25</ambient>
            <diffuse>0.72 0.62 0.05 0.25</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_finished_goods">
      <static>true</static>
      <pose>9.15 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.7 18 0.002</size></box></geometry>
          <material>
            <ambient>0.15 0.62 0.18 0.30</ambient>
            <diffuse>0.15 0.62 0.18 0.30</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================== -->
    <!--  STRUCTURAL COLUMNS (10 pillars, 0.28×0.28 m × 6 m)               -->
    <!--  West/East perimeter : x = ±12.5, y = −9 / 0 / +9                 -->
    <!--  Zone boundaries     : x = ±5.8, y = −9 / +9                      -->
    <!--  Centre (x = 0) supprimé — évite d'obstruer le corridor central    -->
    <!-- ================================================================== -->

    <!-- West colonnade -->
    <model name="col_w_s"><static>true</static><pose>-12.5 -9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_w_c"><static>true</static><pose>-12.5 0 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_w_n"><static>true</static><pose>-12.5 9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>

    <!-- Zone A–B boundary (x = −5.8) -->
    <model name="col_ab_s"><static>true</static><pose>-5.8 -9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_ab_n"><static>true</static><pose>-5.8 9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>

    <!-- Zone C–D boundary (x = +5.8) -->
    <model name="col_cd_s"><static>true</static><pose>5.8 -9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_cd_n"><static>true</static><pose>5.8 9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>

    <!-- East colonnade -->
    <model name="col_e_s"><static>true</static><pose>12.5 -9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_e_c"><static>true</static><pose>12.5 0 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>
    <model name="col_e_n"><static>true</static><pose>12.5 9 3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.28 0.28 6</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.32 0.32 0.35 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.28 6</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================================================================== -->
    <!--  STORAGE RACKS                                                     -->
    <!--  Organised warehouse layout with a clear east-west traffic lane.   -->
    <!--    Raw Materials : x = −11 / −7.5                                 -->
    <!--    Semi-Finished : x = −3.5 / +3.5                                -->
    <!--    Finished Goods: x = +7.5 / +11                                 -->
    <!--  Shelves are kept away from y = 0 to leave a wide central aisle.   -->
    <!-- ================================================================== -->

    <!-- Raw Materials racks -->
    <include><name>Rack_AW_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-11 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AW_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-11 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AW_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-11  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AW_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-11  7.2 0 0 0 1.5708</pose></include>

    <include><name>Rack_AE_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-7.5 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AE_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-7.5 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AE_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-7.5  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_AE_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfD_01</uri>
      <static>true</static><pose>-7.5  7.2 0 0 0 1.5708</pose></include>

    <!-- Semi-Finished racks -->
    <include><name>Rack_BW_0</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>-3.5 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_BW_1</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>-3.5 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_BW_3</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>-3.5  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_BW_4</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>-3.5  7.2 0 0 0 1.5708</pose></include>

    <include><name>Rack_CE_0</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>3.5 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_CE_1</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>3.5 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_CE_3</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>3.5  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_CE_4</name>
      <uri>https://fuel.gazebosim.org/1.0/ctrazziwp/models/shelf</uri>
      <static>true</static><pose>3.5  7.2 0 0 0 1.5708</pose></include>

    <!-- Finished Goods racks -->
    <include><name>Rack_DW_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>7.5 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DW_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>7.5 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DW_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>7.5  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DW_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>7.5  7.2 0 0 0 1.5708</pose></include>

    <include><name>Rack_DE_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>11 -7.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DE_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>11 -3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DE_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>11  3.2 0 0 0 1.5708</pose></include>
    <include><name>Rack_DE_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/aws_robomaker_warehouse_ShelfF_01</uri>
      <static>true</static><pose>11  7.2 0 0 0 1.5708</pose></include>

    <!-- ================================================================== -->
    <!--  PALLET STACKS                                                     -->
    <!-- ================================================================== -->

    <!-- Raw Materials — stock entrant côté ouest -->
    <include><name>Pallet_RM_0</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>-12 -6.2 0 0 0 0</pose></include>
    <include><name>Pallet_RM_1</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>-12 -4.7 0 0 0 0</pose></include>
    <include><name>Pallet_RM_2</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>-12  4.7 0 0 0 0</pose></include>
    <include><name>Pallet_RM_3</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>-12  6.2 0 0 0 0</pose></include>

    <!-- Semi-Finished — stock en cours côté allées -->
    <include><name>Pallet_SF_0</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>-2.2 -8.4 0 0 0 1.5708</pose></include>
    <include><name>Pallet_SF_1</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose> 2.2  8.4 0 0 0 1.5708</pose></include>

    <!-- Finished Goods — stock sortant côté est -->
    <include><name>Pallet_FG_0</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>12 -6.2 0 0 0 0</pose></include>
    <include><name>Pallet_FG_1</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>12 -4.7 0 0 0 0</pose></include>
    <include><name>Pallet_FG_2</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>12  4.7 0 0 0 0</pose></include>
    <include><name>Pallet_FG_3</name>
      <uri>https://fuel.gazebosim.org/1.0/MovAi/models/pallet_box_mobile</uri>
      <static>true</static><pose>12  6.2 0 0 0 0</pose></include>

    <!-- ================================================================== -->
    <!--  PARKED FORKLIFT                                                   -->
    <!-- ================================================================== -->
    <include>
      <name>Forklift_Parked</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Forklift</uri>
      <static>true</static>
      <pose>-10.2 1.8 0 0 0 1.5708</pose>
    </include>

    <!-- ================================================================== -->
    <!--  CARDBOARD BOX STACKS (inline geometry, kept inside shell)         -->
    <!-- ================================================================== -->
    <model name="boxes_rm_0"><static>true</static><pose>-12 -8.3 0.65 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.2 1.0 1.3</size></box></geometry>
          <material><ambient>0.79 0.60 0.28 1</ambient><diffuse>0.79 0.60 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.2 1.0 1.3</size></box></geometry></collision>
      </link>
    </model>
    <model name="boxes_rm_1"><static>true</static><pose>-6.2 -8.3 0.65 0 0 0.2</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.0 1.2 1.1</size></box></geometry>
          <material><ambient>0.79 0.60 0.28 1</ambient><diffuse>0.79 0.60 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.0 1.2 1.1</size></box></geometry></collision>
      </link>
    </model>
    <model name="boxes_fg_0"><static>true</static><pose>12 -8.3 0.65 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.2 1.0 1.4</size></box></geometry>
          <material><ambient>0.72 0.52 0.22 1</ambient><diffuse>0.72 0.52 0.22 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.2 1.0 1.4</size></box></geometry></collision>
      </link>
    </model>
    <model name="boxes_fg_1"><static>true</static><pose>6.2  8.3 0.65 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.2 1.0 1.4</size></box></geometry>
