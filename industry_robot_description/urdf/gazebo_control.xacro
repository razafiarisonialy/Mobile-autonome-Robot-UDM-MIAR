<?xml version="1.0"?>
<!-- ================================================================
     gazebo_control.xacro — Plugins de contrôle Gazebo Harmonic
     Définit le différentiel (DiffDrive) et le publisher d'états joints.
     Compatible gz-sim 8 (Gazebo Harmonic) uniquement.
     ================================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============================================================
         PLUGIN DIFFERENTIAL DRIVE (gz-sim-diff-drive-system)
         Contrôle les 4 roues motrices via /cmd_vel (skid-steer mode).
         Publie l'odométrie sur /odom et la TF odom → base_footprint.

         Paramètres cinématiques :
           - wheel_separation = 2 × wheel_y_offset = 2 × 0.315 = 0.63 m
           - wheel_radius = 0.125 m
           - Vitesse max linéaire : ±1.0 m/s
           - Vitesse max angulaire : ±2.0 rad/s
         ============================================================ -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">
            <!-- Articulations des roues motrices gauches -->
            <left_joint>front_left_wheel_joint</left_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            
            <!-- Articulations des roues motrices droites -->
            <right_joint>front_right_wheel_joint</right_joint>
            <right_joint>rear_right_wheel_joint</right_joint>

            <!-- Géométrie des roues (cohérent avec nouveau robot_core.xacro style Husky A300) -->
            <!-- wheel_separation = 2 × wheel_y_offset = 2 × 0.37 = 0.74 m -->
            <wheel_separation>0.74</wheel_separation>
            <wheel_radius>0.165</wheel_radius>

            <!-- Topics : laissés en défaut Gazebo Harmonic.
                 GZ crée automatiquement :
                   /model/<model_name>/cmd_vel
                   /model/<model_name>/odometry
                   /model/<model_name>/tf
                 Le bridge ROS remappe vers /<namespace>/cmd_vel etc. -->

            <!-- Frames de l'odométrie -->
            <frame_id>${frame_prefix}odom</frame_id>
            <child_frame_id>${frame_prefix}base_footprint</child_frame_id>
            <odometry_frame>${frame_prefix}odom</odometry_frame>
            <robot_base_frame>${frame_prefix}base_footprint</robot_base_frame>

            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>

            <!-- Fréquence de publication de l'odométrie (Hz) -->
            <odom_publish_frequency>50</odom_publish_frequency>

            <!-- Limites d'accélération (m/s² et rad/s²) -->
            <max_linear_acceleration>1.5</max_linear_acceleration>
            <min_linear_acceleration>-1.5</min_linear_acceleration>
            <max_angular_acceleration>3.0</max_angular_acceleration>
            <min_angular_acceleration>-3.0</min_angular_acceleration>

            <!-- Limites de vitesse (m/s et rad/s) -->
            <max_linear_velocity>1.0</max_linear_velocity>
            <min_linear_velocity>-1.0</min_linear_velocity>
            <max_angular_velocity>2.0</max_angular_velocity>
            <min_angular_velocity>-2.0</min_angular_velocity>
        </plugin>
    </gazebo>

    <!-- ============================================================
         PLUGIN JOINT STATE PUBLISHER (gz-sim-joint-state-publisher-system)
         Publie les positions angulaires des roues.
         GZ Harmonic publie par défaut sur /model/<model_name>/joint_states.
         ============================================================ -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
