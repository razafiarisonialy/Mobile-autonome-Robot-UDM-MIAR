<?xml version="1.0"?>
<!-- robot_core.xacro - Corps principal du robot AMR style Husky A300 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Dimensions principales du robot -->
    <xacro:property name="chassis_length" value="0.90"/>
    <xacro:property name="chassis_width"  value="0.54"/>
    <xacro:property name="chassis_height" value="0.25"/>
    <xacro:property name="chassis_mass"   value="45.0"/>

    <xacro:property name="bumper_length" value="0.08"/>
    <xacro:property name="bumper_width"  value="0.62"/>
    <xacro:property name="bumper_height" value="0.11"/>
    <xacro:property name="bumper_mass"   value="2.0"/>

    <xacro:property name="wheel_radius"   value="0.165"/>
    <xacro:property name="wheel_width"    value="0.114"/>
    <xacro:property name="wheel_mass"     value="4.0"/>
    <xacro:property name="wheel_x_offset" value="0.28"/>
    <xacro:property name="wheel_y_offset" value="0.37"/>

    <xacro:property name="cargo_length" value="0.82"/>
    <xacro:property name="cargo_width"  value="0.48"/>
    <xacro:property name="cargo_height" value="0.04"/>
    <xacro:property name="cargo_mass"   value="3.0"/>

    <xacro:property name="mast_width"  value="0.12"/>
    <xacro:property name="mast_height" value="0.12"/>
    <xacro:property name="mast_mass"   value="2.0"/>

    <xacro:property name="rack_height" value="0.22"/>
    <xacro:property name="rack_length" value="0.78"/>
    <xacro:property name="rack_width" value="0.48"/>
    <xacro:property name="rack_thickness" value="0.05"/>
    <xacro:property name="pillar_radius" value="0.035"/>

    <!-- Materials URDF -->
    <material name="light_grey"><color rgba="0.78 0.78 0.78 1.0"/></material>
    <material name="dark_grey"><color rgba="0.25 0.25 0.25 1.0"/></material>
    <material name="silver"><color rgba="0.85 0.85 0.87 1.0"/></material>
    <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
    <material name="blue"><color rgba="0.1 0.4 0.9 1.0"/></material>

    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_link"/>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="chassis_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <xacro:macro name="bumper" params="name x_offset">
        <joint name="${name}_bumper_joint" type="fixed">
            <parent link="chassis_link"/>
            <child link="${name}_bumper_link"/>
            <origin xyz="${x_offset} 0 -0.02" rpy="0 0 0"/>
        </joint>
        <link name="${name}_bumper_link">
            <visual>
                <geometry>
                    <box size="${bumper_length} ${bumper_width} ${bumper_height}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <box size="${bumper_length} ${bumper_width} ${bumper_height}"/>
                </geometry>
            </collision>
            <xacro:inertial_box mass="${bumper_mass}" x="${bumper_length}" y="${bumper_width}" z="${bumper_height}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <gazebo reference="${name}_bumper_link">
            <material>Gazebo/FlatBlack</material>
        </gazebo>
    </xacro:macro>

    <xacro:bumper name="front" x_offset="${chassis_length/2 + bumper_length/2}"/>
    <xacro:bumper name="rear" x_offset="-${chassis_length/2 + bumper_length/2}"/>

    <xacro:macro name="left_wheel" params="prefix x_offset">
        <joint name="${prefix}_left_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_left_wheel_link"/>
            <origin xyz="${x_offset} ${wheel_y_offset} 0" rpy="-1.5708 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
        <link name="${prefix}_left_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_left_wheel_link">
            <material>Gazebo/FlatBlack</material>
            <mu1>0.9</mu1>
            <mu2>0.05</mu2>
            <fdir1>1 0 0</fdir1>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="right_wheel" params="prefix x_offset">
        <joint name="${prefix}_right_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_right_wheel_link"/>
            <origin xyz="${x_offset} -${wheel_y_offset} 0" rpy="1.5708 0 0"/>
            <axis xyz="0 0 -1"/>
        </joint>
        <link name="${prefix}_right_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_right_wheel_link">
            <material>Gazebo/FlatBlack</material>
            <mu1>0.9</mu1>
            <mu2>0.05</mu2>
            <fdir1>1 0 0</fdir1>
        </gazebo>
    </xacro:macro>

    <xacro:left_wheel prefix="front" x_offset="${wheel_x_offset}"/>
    <xacro:left_wheel prefix="rear" x_offset="-${wheel_x_offset}"/>
    <xacro:right_wheel prefix="front" x_offset="${wheel_x_offset}"/>
    <xacro:right_wheel prefix="rear" x_offset="-${wheel_x_offset}"/>

    <joint name="cargo_platform_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="cargo_platform_link"/>
        <origin xyz="0 0 ${chassis_height/2 + cargo_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="cargo_platform_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <xacro:inertial_box mass="${cargo_mass}" x="${cargo_length}" y="${cargo_width}" z="${cargo_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="cargo_platform_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <joint name="sensor_mast_joint" type="fixed">
        <parent link="cargo_platform_link"/>
        <child link="sensor_mast_link"/>
        <origin xyz="0.25 0 ${cargo_height/2 + mast_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="sensor_mast_link">
        <visual>
            <geometry>
                <cylinder radius="${mast_width/2}" length="${mast_height}"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${mast_width/2}" length="${mast_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${mast_mass}" radius="${mast_width/2}" length="${mast_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="sensor_mast_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <xacro:macro name="rack_pillar" params="prefix x_pos y_pos">
        <joint name="${prefix}_pillar_joint" type="fixed">
            <parent link="cargo_platform_link"/>
            <child link="${prefix}_pillar_link"/>
            <origin xyz="${x_pos} ${y_pos} ${rack_height/2}" rpy="0 0 0"/>
        </joint>
        <link name="${prefix}_pillar_link">
            <visual>
                <geometry>
                    <cylinder radius="${pillar_radius}" length="${rack_height}"/>
                </geometry>
                <material name="silver"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${pillar_radius}" length="${rack_height}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="1.5" radius="${pillar_radius}" length="${rack_height}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_pillar_link">
            <material>Gazebo/Grey</material>
        </gazebo>
    </xacro:macro>

    <xacro:rack_pillar prefix="front_left" x_pos="0.25" y_pos="0.20"/>
    <xacro:rack_pillar prefix="front_right" x_pos="0.25" y_pos="-0.20"/>
    <xacro:rack_pillar prefix="rear_left" x_pos="-0.30" y_pos="0.20"/>
    <xacro:rack_pillar prefix="rear_right" x_pos="-0.30" y_pos="-0.20"/>

    <joint name="payload_rack_joint" type="fixed">
        <parent link="cargo_platform_link"/>
        <child link="payload_rack_link"/>
        <origin xyz="-0.025 0 ${rack_height + rack_thickness/2}" rpy="0 0 0"/>
    </joint>

    <link name="payload_rack_link">
        <visual>
            <geometry>
                <box size="${rack_length} ${rack_width} ${rack_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <box size="${rack_length} ${rack_width} ${rack_thickness}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="3.0" x="${rack_length}" y="${rack_width}" z="${rack_thickness}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="payload_rack_link">
        <material>Gazebo/Blue</material>
    </gazebo>

</robot>
