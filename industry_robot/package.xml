<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>industry_robot</name>
  <version>1.0.0</version>
  <description>
    Robot mobile autonome (AMR) pour entrepôt de fabrication de cartons.
    Modèle différentiel inspiré du TurtleBot3 Waffle, adapté pour la logistique.
    Simulation sous Gazebo Harmonic avec ROS 2 Jazzy.
  </description>
  <maintainer email="razafiarisonialy@gmail.com">ialy</maintainer>
  <license>TODO: License declaration</license>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dépendances de description du robot -->
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>

  <!-- Dépendances Gazebo Harmonic et bridge -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Dépendances de visualisation -->
  <exec_depend>rviz2</exec_depend>

  <!-- Filtrage du scan LiDAR (self-detection) -->
  <exec_depend>laser_filters</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
