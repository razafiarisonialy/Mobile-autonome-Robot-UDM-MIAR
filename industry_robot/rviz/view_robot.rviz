Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    # --- Grille de référence ---
    - Class: rviz_default_plugins/Grid
      Name: Grille
      Enabled: true
      Cell Count: 20
      Cell Size: 0.5
      Color: 100; 100; 100
      Line Style:
        Value: Lines
      Plane: XY
      Plane Cell Count: 20

    # --- Modèle 3D du robot ---
    - Class: rviz_default_plugins/RobotModel
      Name: Modèle Robot
      Description Topic:
        Value: /robot_description
      Enabled: true
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0

    # --- Arbre des transformations ---
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3

    # --- Données LiDAR (nuage de points 2D) ---
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Scan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Enabled: true
      Queue Size: 5

    # --- Odométrie (flèche de direction) ---
    - Class: rviz_default_plugins/Odometry
      Name: Odométrie
      Topic:
        Value: /odom
      Enabled: true
      Keep: 50
      Shape:
        Value: Arrow
      Covariance:
        Value: false
      Position Tolerance: 0.1
      Angle Tolerance: 0.1

  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    Background Color: 48; 48; 48

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Pitch: 0.45
      Yaw: 0.785
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.15
      Target Frame: base_footprint
      Near Clip Distance: 0.01
      Far Clip Distance: 100.0
