<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_core_name)">

    <xacro:arg name="robot_core_name" default="warehouse_bot"/>
    <xacro:arg name="namespace" default=""/>
    
    <xacro:if value="${'$(arg namespace)' != ''}">
        <xacro:property name="topic_prefix" value="/$(arg namespace)" />
        <xacro:property name="frame_prefix" value="$(arg namespace)/" />
    </xacro:if>
    <xacro:if value="${'$(arg namespace)' == ''}">
        <xacro:property name="topic_prefix" value="" />
        <xacro:property name="frame_prefix" value="" />
    </xacro:if>

    <!-- Inclure les macros d'inertie -->
    <xacro:include filename="inertial_macros.xacro"/>

    <!-- Inclure le corps du robot -->
    <xacro:include filename="robot_core.xacro"/>

    <!-- Inclure le LiDAR -->
    <xacro:include filename="lidar.xacro"/>

    <!-- Inclure l'IMU -->
    <xacro:include filename="imu.xacro"/>

    <!-- Inclure les plugins Gazebo -->
    <xacro:include filename="gazebo_control.xacro"/>

</robot>
