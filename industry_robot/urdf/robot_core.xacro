<?xml version="1.0"?>
<!-- robot_core.xacro — Corps principal du robot AMR d'entrepôt -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Châssis principal -->
    <xacro:property name="chassis_length" value="0.35"/>
    <xacro:property name="chassis_width"  value="0.30"/>
    <xacro:property name="chassis_height" value="0.12"/>
    <xacro:property name="chassis_mass"   value="3.0"/>

    <!-- Roues motrices (arrière) -->
    <xacro:property name="wheel_radius"   value="0.065"/>
    <xacro:property name="wheel_width"    value="0.03"/>
    <xacro:property name="wheel_mass"     value="0.25"/>
    <xacro:property name="wheel_x_offset" value="-0.08"/>
    <xacro:property name="wheel_y_offset" value="0.165"/>

    <!-- Roue folle (avant) -->
    <xacro:property name="caster_radius"  value="0.025"/>
    <xacro:property name="caster_mass"    value="0.1"/>

    <!-- Plateau cargo -->
    <xacro:property name="cargo_length"   value="0.30"/>
    <xacro:property name="cargo_width"    value="0.25"/>
    <xacro:property name="cargo_height"   value="0.01"/>
    <xacro:property name="cargo_mass"     value="0.3"/>
    <xacro:property name="cargo_z_offset" value="0.11"/>

    <!-- Mât avant (support LiDAR + phares) -->
    <xacro:property name="mast_length"    value="0.04"/>
    <xacro:property name="mast_width"     value="0.20"/>
    <xacro:property name="mast_height"    value="0.10"/>
    <xacro:property name="mast_mass"      value="0.3"/>

    <!-- COULEURS (materials URDF pour RViz) -->
    <material name="light_grey">  <color rgba="0.78 0.78 0.78 1.0"/> </material>
    <material name="dark_grey">   <color rgba="0.25 0.25 0.25 1.0"/> </material>
    <material name="silver">      <color rgba="0.85 0.85 0.87 1.0"/> </material>
    <material name="black">       <color rgba="0.05 0.05 0.05 1.0"/> </material>
    <material name="red">         <color rgba="0.85 0.10 0.10 1.0"/> </material>
    <material name="yellow">      <color rgba="1.0 0.85 0.0 1.0"/>   </material>
    <material name="orange">      <color rgba="1.0 0.55 0.0 1.0"/>   </material>
    <material name="green_led">   <color rgba="0.2 0.9 0.2 1.0"/>    </material>

    <!-- projection au sol du robot (z = 0) -->
    <link name="base_footprint"/>

    <!-- Élevé de wheel_radius au-dessus du sol-->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_link"/>

    <!-- CHÂSSIS boîte métallique principale  -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </joint>

    <link name="chassis_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!-- ROUE GAUCHE (motrice, arrière gauche) Attachée à base_link, orientée pour tourner autour de Y. -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${wheel_x_offset} ${wheel_y_offset} 0" rpy="-1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel_link">
        <material>Gazebo/FlatBlack</material>
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
    </gazebo>

    <!-- ROUE DROITE (motrice, arrière droite) Symétrique de la roue gauche par rapport au plan xz -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${wheel_x_offset} -${wheel_y_offset} 0" rpy="1.5708 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel_link">
        <material>Gazebo/FlatBlack</material>
        <mu1>0.9</mu1>
        <mu2>0.9</mu2>
    </gazebo>

    <!-- ROUE FOLLE AVANT (caster ball) -->
    <joint name="caster_wheel_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="0.13 0 -0.10" rpy="0 0 0"/>
    </joint>

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="caster_wheel_link">
        <material>Gazebo/DarkGrey</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <!-- PILIERS DE SUPPORT — 4 montants reliant le châssis au plateau -->
    <xacro:property name="post_radius" value="0.008"/>
    <xacro:property name="post_length" value="0.045"/>
    <xacro:property name="post_z" value="${chassis_height/2 + post_length/2 + 0.005}"/>

    <xacro:macro name="support_post" params="prefix x y">
        <joint name="${prefix}_post_joint" type="fixed">
            <parent link="chassis_link"/>
            <child link="${prefix}_post_link"/>
            <origin xyz="${x} ${y} ${post_z}" rpy="0 0 0"/>
        </joint>
        <link name="${prefix}_post_link">
            <visual>
                <geometry>
                    <cylinder radius="${post_radius}" length="${post_length}"/>
                </geometry>
                <material name="dark_grey"/>
            </visual>
            <xacro:inertial_cylinder mass="0.03" length="${post_length}" radius="${post_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_post_link">
            <material>Gazebo/DarkGrey</material>
        </gazebo>
    </xacro:macro>

    <!-- Instanciation des 4 piliers aux coins du plateau -->
    <xacro:support_post prefix="front_left"  x="0.11"  y="0.09"/>
    <xacro:support_post prefix="front_right" x="0.11"  y="-0.09"/>
    <xacro:support_post prefix="rear_left"   x="-0.11" y="0.09"/>
    <xacro:support_post prefix="rear_right"  x="-0.11" y="-0.09"/>

    <!--  PLATEAU CARGO — surface plate pour transporter les cartons -->
    <joint name="cargo_platform_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="cargo_platform_link"/>
        <origin xyz="0 0 ${cargo_z_offset}" rpy="0 0 0"/>
    </joint>

    <link name="cargo_platform_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${cargo_length} ${cargo_width} ${cargo_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${cargo_mass}" x="${cargo_length}" y="${cargo_width}" z="${cargo_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="cargo_platform_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- RAILS LATÉRAUX — garde-corps sur le plateau  -->
    <xacro:macro name="side_rail" params="prefix y_pos">
        <joint name="${prefix}_rail_joint" type="fixed">
            <parent link="cargo_platform_link"/>
            <child link="${prefix}_rail_link"/>
            <origin xyz="0 ${y_pos} 0.025" rpy="0 0 0"/>
        </joint>
        <link name="${prefix}_rail_link">
            <visual>
                <geometry>
                    <box size="${cargo_length} 0.008 0.04"/>
                </geometry>
                <material name="light_grey"/>
            </visual>
            <xacro:inertial_box mass="0.06" x="${cargo_length}" y="0.008" z="0.04">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
        <gazebo reference="${prefix}_rail_link">
            <material>Gazebo/Grey</material>
        </gazebo>
    </xacro:macro>

    <xacro:side_rail prefix="left"  y_pos="0.12"/>
    <xacro:side_rail prefix="right" y_pos="-0.12"/>

    <!-- PARE-CHOCS AVANT — barre de protection industrielle -->
    <joint name="front_bumper_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="front_bumper_link"/>
        <origin xyz="${chassis_length/2 + 0.01} 0 -0.03" rpy="0 0 0"/>
    </joint>

    <link name="front_bumper_link">
        <visual>
            <geometry>
                <box size="0.015 ${chassis_width + 0.02} 0.025"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.015 ${chassis_width + 0.02} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.1" x="0.015" y="${chassis_width + 0.02}" z="0.025">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="front_bumper_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!--  MÂT AVANT — structure portant le LiDAR et les phares  -->
    <joint name="front_mast_joint" type="fixed">
        <parent link="chassis_link"/>
        <child link="front_mast_link"/>
        <origin xyz="0.13 0 0.12" rpy="0 0 0"/>
    </joint>

    <link name="front_mast_link">
        <visual>
            <geometry>
                <box size="${mast_length} ${mast_width} ${mast_height}"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <geometry>
                <box size="${mast_length} ${mast_width} ${mast_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${mast_mass}" x="${mast_length}" y="${mast_width}" z="${mast_height}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="front_mast_link">
        <material>Gazebo/Grey</material>
    </gazebo>

    <!--  BOUTON D'ARRÊT D'URGENCE (E-Stop) — visuel décoratif-->
    <joint name="estop_joint" type="fixed">
        <parent link="front_mast_link"/>
        <child link="estop_link"/>
        <origin xyz="0.025 -0.08 0.03" rpy="0 1.5708 0"/>
    </joint>

    <link name="estop_link">
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.015"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <gazebo reference="estop_link">
        <material>Gazebo/Red</material>
    </gazebo>

    <!--  PHARES AVANT — 2 petites lumières LED sur le mât -->
    <xacro:macro name="headlight" params="prefix y_offset">
        <joint name="${prefix}_light_joint" type="fixed">
            <parent link="front_mast_link"/>
            <child link="${prefix}_light_link"/>
            <origin xyz="0.025 ${y_offset} -0.02" rpy="0 1.5708 0"/>
        </joint>
        <link name="${prefix}_light_link">
            <visual>
                <geometry>
                    <cylinder radius="0.01" length="0.008"/>
                </geometry>
                <material name="yellow"/>
            </visual>
        </link>
        <gazebo reference="${prefix}_light_link">
            <material>Gazebo/Yellow</material>
        </gazebo>
    </xacro:macro>

    <xacro:headlight prefix="left_head"  y_offset="0.04"/>
    <xacro:headlight prefix="right_head" y_offset="-0.04"/>

    <!-- INDICATEUR LED STATUS — petit voyant vert sur le mât -->
    <joint name="status_led_joint" type="fixed">
        <parent link="front_mast_link"/>
        <child link="status_led_link"/>
        <origin xyz="0.025 0 0.04" rpy="0 1.5708 0"/>
    </joint>

    <link name="status_led_link">
        <visual>
            <geometry>
                <cylinder radius="0.006" length="0.005"/>
            </geometry>
            <material name="green_led"/>
        </visual>
    </link>

    <gazebo reference="status_led_link">
        <material>Gazebo/Green</material>
    </gazebo>

</robot>
