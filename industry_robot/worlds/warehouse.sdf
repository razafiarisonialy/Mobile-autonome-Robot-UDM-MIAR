<?xml version="1.0" ?>
<!-- ================================================================
     warehouse.sdf — Monde d'entrepôt simplifié pour Gazebo Harmonic
     Contient : sol, éclairage, murs d'enceinte et quelques obstacles
     (étagères, palettes de cartons) pour tester la navigation.
     ================================================================ -->
<sdf version="1.9">
  <world name="warehouse">

    <!-- ============================================================
         PLUGINS MONDE (physique, capteurs, interaction utilisateur)
         ============================================================ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ============================================================
         ÉCLAIRAGE — lumière directionnelle type éclairage industriel
         ============================================================ -->
    <light type="directional" name="warehouse_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Lumière d'appoint pour réduire les ombres trop dures -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.2 -1.0</direction>
    </light>

    <!-- ============================================================
         SOL DE L'ENTREPÔT — grande surface plane en béton
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.58 1</ambient>
            <diffuse>0.65 0.65 0.62 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         MURS D'ENCEINTE — délimitent la zone navigable (10×8 m)
         ============================================================ -->
    <!-- Mur Nord -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.68 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur Sud -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.68 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur Est -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.68 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mur Ouest -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8.15 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.68 1</ambient>
            <diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ÉTAGÈRES DE STOCKAGE — obstacles réalistes d'entrepôt
         Représentent des rayonnages industriels.
         ============================================================ -->
    <!-- Étagère 1 — rangée gauche -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-3.0 1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.55 1</ambient>
            <diffuse>0.35 0.4 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Étagère 2 — rangée gauche (suite) -->
    <model name="shelf_2">
      <static>true</static>
      <pose>-3.0 -1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.55 1</ambient>
            <diffuse>0.35 0.4 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Étagère 3 — rangée droite -->
    <model name="shelf_3">
      <static>true</static>
      <pose>2.5 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.5 1.2</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.55 1</ambient>
            <diffuse>0.35 0.4 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         PALETTES DE CARTONS — obstacles petits et dispersés
         Simulent des piles de cartons dans l'entrepôt.
         ============================================================ -->
    <!-- Palette 1 -->
    <model name="cardbox_stack_1">
      <static>true</static>
      <pose>1.0 -2.0 0.25 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.18 1</ambient>
            <diffuse>0.65 0.45 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Palette 2 -->
    <model name="cardbox_stack_2">
      <static>true</static>
      <pose>-1.0 -2.5 0.20 0 0 -0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.5 0.35 0.15 1</ambient>
            <diffuse>0.6 0.42 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Palette 3 — grand empilement -->
    <model name="cardbox_stack_3">
      <static>true</static>
      <pose>3.0 -1.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.45 0.32 0.15 1</ambient>
            <diffuse>0.55 0.40 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         PILIER STRUCTUREL — colonne porteuse de l'entrepôt
         ============================================================ -->
    <model name="pillar_1">
      <static>true</static>
      <pose>0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>2.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>2.5</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.5 0.48 1</ambient>
            <diffuse>0.6 0.6 0.57 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
